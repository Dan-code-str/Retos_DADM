<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_search">

        <EditTextPreference
            app:defaultValue="1"
            app:dialogTitle="@string/pref_radius_title"
            app:key="radius_km"
            app:title="@string/pref_radius_title" />

        <MultiSelectListPreference
            app:defaultValue="@array/poi_category_defaults"
            app:entries="@array/poi_category_labels"
            app:entryValues="@array/poi_category_values"
            app:key="categories"
            app:title="@string/pref_categories_title" />

    </PreferenceCategory>
</PreferenceScreen>
