<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="@color/violeta"
                    android:shadowRadius="18"
                    android:text="@string/titulo"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/subtitulo"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonClave"
                style="?attr/materialIconButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/desc_boton_clave"
                app:icon="@drawable/ic_clave" />
        </LinearLayout>

        <!-- Idea del usuario -->
        <TextView
            style="@style/Reto11.Seccion"
            android:layout_marginTop="24dp"
            android:labelFor="@id/campoIdea"
            android:text="@string/seccion_idea" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutIdea"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:counterEnabled="true"
            app:counterMaxLength="800"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoIdea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:hint="@string/pista_idea"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="800"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonMejorar"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/boton_mejorar"
            app:icon="@drawable/ic_destellos" />

        <!-- Opciones que completan el prompt -->
        <TextView
            style="@style/Reto11.Seccion"
            android:text="@string/seccion_estilo" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoEstilo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <TextView
            style="@style/Reto11.Seccion"
            android:text="@string/seccion_ambiente" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoAmbiente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true" />

        <TextView
            android:id="@+id/textoSeccionFormato"
            style="@style/Reto11.Seccion"
            android:text="@string/seccion_formato" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoFormato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonGenerar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/boton_generar"
            app:icon="@drawable/ic_imagen" />

        <include layout="@layout/layout_estado" />

        <!-- Resultado -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaResultado"
            style="?attr/materialCardViewFilledStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imagenResultado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="@drawable/fondo_lienzo"
                    android:contentDescription="@string/desc_imagen_resultado"
                    android:minHeight="160dp"
                    android:scaleType="fitCenter"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Reto11.Imagen" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/etiqueta_prompt"
                    android:textAllCaps="true"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/textoPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textIsSelectable="true"
                    tools:text="Genera una imagen de: un colibrí de vidrio…" />

                <TextView
                    android:id="@+id/textoComentario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorSecondary"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonGuardar"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/boton_guardar"
                        app:icon="@drawable/ic_guardar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/botonCompartir"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/boton_compartir"
                        app:icon="@drawable/ic_compartir" />
                </LinearLayout>

                <!-- Refinar: la imagen actual + una instrucción vuelven a Gemini -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutCambio"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/pista_cambio">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoCambio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSend"
                        android:inputType="text|textCapSentences"
                        android:maxLength="200" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonRefinar"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/boton_refinar"
                    app:icon="@drawable/ic_editar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Historial -->
        <TextView
            style="@style/Reto11.Seccion"
            android:layout_marginTop="24dp"
            android:text="@string/seccion_historial" />

        <TextView
            android:id="@+id/textoHistorialVacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/historial_vacio"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contenedorHistorial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/textoPie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Imágenes generadas con Google Gemini · modelo gemini-2.5-flash-image" />
    </LinearLayout>
</ScrollView>
