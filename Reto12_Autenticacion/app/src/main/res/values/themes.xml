<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Reto12" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/github_negro</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/github_negro</item>
        <item name="colorError">@color/rojo</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/blanco</item>
        <item name="colorOnSurface">@color/github_negro</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Estilos de texto reutilizables -->
    <style name="Texto.Titulo" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/github_negro</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Texto.Subtitulo" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Texto.Etiqueta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Texto.Valor" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/github_negro</item>
    </style>

    <style name="Texto.Paso" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/github_negro</item>
    </style>

    <style name="Boton.Principal" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/github_negro</item>
        <item name="android:textColor">@color/blanco</item>
    </style>

    <style name="Boton.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/github_negro</item>
        <item name="strokeColor">@color/borde</item>
    </style>

    <style name="Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">@color/blanco</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
