<?xml version="1.0" encoding="utf-8"?>
<!-- Space Grotesk (OFL) es una fuente variable: el mismo archivo da el peso normal y el negrita. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/space_grotesk"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 450"
        android:fontWeight="400"
        app:font="@font/space_grotesk"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 450"
        app:fontWeight="400" />
    <font
        android:font="@font/space_grotesk"
        android:fontStyle="normal"
        android:fontVariationSettings="'wght' 700"
        android:fontWeight="700"
        app:font="@font/space_grotesk"
        app:fontStyle="normal"
        app:fontVariationSettings="'wght' 700"
        app:fontWeight="700" />
</font-family>
