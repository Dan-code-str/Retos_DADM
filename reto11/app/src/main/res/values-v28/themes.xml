<resources>
    <!-- En Android 9+ las sombras pueden tener color: se usan para el efecto de resplandor. -->
    <style name="Widget.Reto11.Button" parent="Widget.Material3.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:outlineSpotShadowColor">@color/violeta</item>
        <item name="android:outlineAmbientShadowColor">@color/violeta</item>
    </style>

    <style name="Widget.Reto11.Card" parent="Widget.Material3.CardView.Filled">
        <item name="strokeColor">@color/contorno_suave</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="android:outlineSpotShadowColor">@color/violeta</item>
        <item name="android:outlineAmbientShadowColor">@color/violeta</item>
    </style>
</resources>
